# Backend URL the browser hits — must be reachable from the user's machine.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side fallback used during SSR. Same as the public URL for local dev;
# in docker-compose this is overridden to `http://backend:4000` so SSR can
# reach the backend over the docker network.
API_URL=http://localhost:4000
